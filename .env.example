# Slack Bot User OAuth Token (starts with xoxb-)
# Found at: Slack App > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App-Level Token (starts with xapp-)
# Found at: Slack App > Basic Information > App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token

# Slack Channel ID for the #claude-connect channel
# Right-click channel name > "View channel details" > scroll to bottom for Channel ID
SLACK_CHANNEL_ID=C0123456789

# Port for the local bridge server (default: 3456)
BRIDGE_PORT=3456

# How long to wait for a Slack response before timing out (seconds, default: 120)
HOOK_TIMEOUT_SECONDS=120
